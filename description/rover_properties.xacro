<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- TEAM LEAD CAD SPECIFICATIONS -->
  <xacro:property name="base_length" value="0.6" />
  <xacro:property name="base_width" value="0.6" />
  <xacro:property name="base_height" value="0.304" />
  <xacro:property name="base_mass" value="1.0" />

  <xacro:property name="wheel_radius" value="0.15" />
  <xacro:property name="wheel_length" value="0.11" />
  <xacro:property name="wheel_mass" value="1.0" />
  <xacro:property name="wheel_zoffset" value="0.225" />

  <xacro:property name="suspension_length" value="0.8850" />
  <xacro:property name="suspension_width" value="0.0367" />
  <xacro:property name="suspension_height" value="0.0367" />
  <xacro:property name="suspension_mass" value="1.0" />

  <xacro:property name="steer_length" value="0.15" />
  <xacro:property name="steer_width" value="0.15" />
  <xacro:property name="steer_height" value="0.08" />
  <xacro:property name="steer_mass" value="1.0" />
  <xacro:property name="steer_xoffset" value="0.0" />
  <xacro:property name="steer_zoffset" value="0.025" />

  <!-- PRESERVED SPACING PADDING -->
  <xacro:property name="susp_dy" value="${(base_width / 2) + 0.08}"/>

  <!-- MATERIALS -->
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="white"><color rgba="0.95 0.95 0.95 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="silver"><color rgba="0.75 0.75 0.75 1"/></material>
  <material name="gold"><color rgba="0.8 0.65 0.1 1"/></material>
  <material name="accent"><color rgba="0.8 0.2 0.0 1"/></material>

</robot>