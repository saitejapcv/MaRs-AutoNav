<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonavtest">

  <!-- INCLUDES -->
  <xacro:include filename="rover_properties.xacro"/>
  <xacro:include filename="chassis.xacro"/>
  <xacro:include filename="suspension.xacro"/>
  <xacro:include filename="wheel.xacro"/>

  <!-- DEPLOY SUSPENSION & WHEELS -->
  <xacro:suspension_arm side="left"  y_reflect="1.0"/>
  <xacro:suspension_arm side="right" y_reflect="-1.0"/>

  <xacro:swerve_wheel prefix="front_left"  parent_arm="left_suspension_link"  x_reflect="1.0"  y_reflect="1.0"/>
  <xacro:swerve_wheel prefix="rear_left"   parent_arm="left_suspension_link"  x_reflect="-1.0" y_reflect="1.0"/>
  <xacro:swerve_wheel prefix="front_right" parent_arm="right_suspension_link" x_reflect="1.0"  y_reflect="-1.0"/>
  <xacro:swerve_wheel prefix="rear_right"  parent_arm="right_suspension_link" x_reflect="-1.0" y_reflect="-1.0"/>

  <!-- ROS 2 CONTROL HARDWARE INTERFACES -->
  <ros2_control name="IgnitionSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="front_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="front_left_drive_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_drive_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_drive_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_right_drive_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find autonavtest)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- GAZEBO MATERIAL OVERRIDES -->
  <gazebo reference="top_deck_link">
    <material>
      <ambient>0.8 0.65 0.1 1.0</ambient>
      <diffuse>0.8 0.65 0.1 1.0</diffuse>
      <specular>0.5 0.5 0.5 1.0</specular>
    </material>
  </gazebo>

  <!-- GAZEBO SENSORS -->

  <!-- GPS SENSOR PLUGIN -->
  <gazebo reference="gps_link">
    <sensor name="rover_gps" type="navsat">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <topic>/gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
    </sensor>
  </gazebo>
  
  <gazebo reference="imu_link">
    <sensor name="rover_imu" type="imu">
      <always_on>1</always_on>
      <update_rate>50.0</update_rate>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <gz_frame_id>imu_link</gz_frame_id>
      <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>
    </sensor>
  </gazebo>

  <!-- 2D LIDAR SENSOR PLUGIN -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ZED 2i FUNCTIONAL REPLICA (RGB + Depth) -->
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <topic>/depth_camera/image_raw</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <!-- ~110 Degree Horizontal FOV to match ZED 2i -->
        <horizontal_fov>1.92</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <!-- ZED 2i realistic depth limits -->
          <near>0.3</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>