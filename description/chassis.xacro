<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 ${wheel_zoffset + 0.08}" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.2"/>
    </inertial>
  </link>

  <link name="top_deck_link">
    <visual>
      <geometry><box size="${base_length * 0.95} ${base_width * 0.95} 0.01"/></geometry>
      <material name="gold"/>
    </visual>
  </link>
  <joint name="top_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_deck_link"/>
    <origin xyz="0.0 0.0 ${base_height / 2 + 0.005}" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- ================= LIDAR MAST & MOUNT ================= -->
  <link name="lidar_mast_link">
    <visual>
      <geometry><cylinder radius="${lidar_mast_radius}" length="${lidar_mast_height}"/></geometry>
      <material name="black"/>
      <origin xyz="0 0 ${lidar_mast_height/2}" rpy="0 0 0"/> 
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_mast_radius}" length="${lidar_mast_height}"/></geometry>
      <origin xyz="0 0 ${lidar_mast_height/2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="lidar_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mast_link"/>
    <origin xyz="${lidar_mast_x_offset} 0.0 ${base_height/2 + 0.01}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_plate_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.005"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_plate_joint" type="fixed">
    <parent link="lidar_mast_link"/>
    <child link="lidar_plate_link"/>
    <origin xyz="0.0 0.0 ${lidar_mast_height + 0.0025}" rpy="0 0 0"/>
  </joint>

  <!-- ================= 2D LIDAR ================= -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="black"/> 
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_plate_link"/> 
    <child link="lidar_link"/>
    <origin xyz="0 0 0.0225" rpy="0 0 0"/>
  </joint>

  <!-- ================= CAMERA EXTENSION BEAM ================= -->
  <link name="camera_beam_link">
    <visual>
      <geometry><box size="${camera_beam_length} 0.03 0.03"/></geometry>
      <material name="black"/>
      <origin xyz="${camera_beam_length/2} 0 0" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="${camera_beam_length} 0.03 0.03"/></geometry>
      <origin xyz="${camera_beam_length/2} 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="camera_beam_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_beam_link"/>
    <origin xyz="${camera_beam_x_start} ${camera_beam_y_offset} ${camera_beam_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- ================= CAMERA MOUNTING PLATE ================= -->
  <link name="camera_mount_plate">
    <visual>
      <geometry><box size="0.01 0.06 0.06"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="0.01 0.06 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="camera_plate_joint" type="fixed">
    <parent link="camera_beam_link"/>
    <child link="camera_mount_plate"/>
    <!-- Attached to the tip of the beam, applying the downward tilt here -->
    <origin xyz="${camera_beam_length} 0 0" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- ================= ZED 2i CAMERA REPLICA ================= -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.14 0.04"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.14 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.16"/> 
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount_plate"/> 
    <child link="camera_link"/>
    <!-- Sits perfectly flush against the tilted plate -->
    <origin xyz="0.025 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame to match ROS image standards -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ================= GPS MODULE ================= -->
  <link name="gps_link">
    <visual>
      <geometry><box size="0.04 0.04 0.015"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="${gps_x_offset} ${gps_y_offset} ${gps_z_offset}" rpy="0 0 0"/>
  </joint>
</robot>