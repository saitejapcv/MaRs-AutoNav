<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 ${wheel_zoffset}" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.2"/>
    </inertial>
  </link>

  <link name="top_deck_link">
    <visual>
      <geometry><box size="${base_length * 0.95} ${base_width * 0.95} 0.01"/></geometry>
      <material name="gold"/>
    </visual>
  </link>
  <joint name="top_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_deck_link"/>
    <origin xyz="0.0 0.0 ${base_height / 2 + 0.005}" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="mast_link">
    <visual>
      <geometry><cylinder radius="0.01" length="0.4"/></geometry>
      <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.01" length="0.4"/></geometry>
      <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="${-base_length / 2 + 0.05} 0.1 ${base_height / 2}" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.14 0.04"/></geometry>
      <material name="white"/>
    </visual>
    <visual>
      <origin xyz="0.02 0.04 0.0" rpy="0.0 1.5708 0.0"/>
      <geometry><cylinder radius="0.012" length="0.01"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.02 -0.04 0.0" rpy="0.0 1.5708 0.0"/>
      <geometry><cylinder radius="0.012" length="0.01"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0 0.0 0.4" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 -1.5708"/>
  </joint>
</robot>