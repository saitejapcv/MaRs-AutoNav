<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cat_rover">

  <xacro:include filename="cat_rover_properties.xacro"/>

  <!-- ================= BASE FOOTPRINT ================= -->
  <!-- Anchors on the ground plane directly below the chassis center -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- ================= BASE LINK (CENTRAL CHASSIS) ================= -->
  <link name="base_link">
    <!-- Main Frame Body (Yellow/Gold Anodized Structure) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="cat_gold"/>
    </visual>
    <!-- Central Inner Cavity (Black Core) -->
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length * 0.88} ${chassis_width * 0.85} ${chassis_height * 0.80}"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="0.35" ixy="0.0" ixz="0.0" 
               iyy="0.55" iyz="0.0" 
               izz="0.65"/>
    </inertial>
  </link>

  <!-- ================= TOP DECK & ELECTRONICS ================= -->
  <link name="top_deck_link">
    <!-- Top Mounting Plate -->
    <visual>
      <geometry>
        <box size="${chassis_length * 0.98} ${chassis_width * 0.98} 0.012"/>
      </geometry>
      <material name="aluminum_silver"/>
    </visual>
    <!-- Electronics Control Box -->
    <visual>
      <origin xyz="-0.08 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.26 0.06"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <!-- COTS E-STOP Button (Red Mushroom with Yellow Collar) -->
    <visual>
      <origin xyz="0.16 0.12 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.04"/>
      </geometry>
      <material name="estop_red"/>
    </visual>
    <visual>
      <origin xyz="0.16 0.12 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.015"/>
      </geometry>
      <material name="cat_gold"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length * 0.98} ${chassis_width * 0.98} 0.012"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="top_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_deck_link"/>
    <origin xyz="0 0 ${chassis_height / 2.0 + 0.006}" rpy="0 0 0"/>
  </joint>

  <!-- ================= FOUR STRADDLE LEGS & WHEEL MACRO ================= -->
  <xacro:macro name="cat_leg_and_wheel" params="prefix x_sign y_sign">

    <!-- Leg Strut (Diagonal Aluminum Extrusion Tube) -->
    <link name="${prefix}_leg_link">
      <visual>
        <!-- Cylinder oriented along the diagonal direction -->
        <origin xyz="${x_sign * 0.10} ${y_sign * 0.10} -0.115" rpy="${y_sign * 0.62} ${-x_sign * 0.62} 0"/>
        <geometry>
          <cylinder radius="${leg_radius}" length="0.36"/>
        </geometry>
        <material name="aluminum_silver"/>
      </visual>
      <!-- Wheel Mount Bracket at bottom of leg -->
      <visual>
        <origin xyz="${x_sign * 0.20} ${y_sign * 0.20} -0.23" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.06 0.08"/>
        </geometry>
        <material name="matte_black"/>
      </visual>
      <collision>
        <origin xyz="${x_sign * 0.10} ${y_sign * 0.10} -0.115" rpy="${y_sign * 0.62} ${-x_sign * 0.62} 0"/>
        <geometry>
          <cylinder radius="${leg_radius}" length="0.36"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${x_sign * 0.10} ${y_sign * 0.10} -0.115" rpy="0 0 0"/>
        <mass value="${leg_mass}"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
      </inertial>
    </link>

    <!-- Prismatic Suspension Joint: gives deep vertical compliance so wheel drops into craters -->
    <joint name="${prefix}_leg_joint" type="prismatic">
      <parent link="base_link"/>
      <child link="${prefix}_leg_link"/>
      <origin xyz="${x_sign * (chassis_length/2.0 - 0.05)} ${y_sign * (chassis_width/2.0 - 0.03)} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.28" upper="0.08" effort="1200.0" velocity="2.0"/>
      <dynamics damping="25.0" friction="0.05"/>
    </joint>

    <gazebo reference="${prefix}_leg_joint">
      <springStiffness>450.0</springStiffness>
      <springReference>-0.12</springReference>
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>

    <!-- Cleated Sand Wheel -->
    <link name="${prefix}_wheel_link">
      <!-- High-Fidelity Cleated Wheel Mesh -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://caterpillar_challenge/description/meshes/cleated_wheel.obj" scale="1 1 1"/>
        </geometry>
        <material name="wheel_white"/>
      </visual>
      <!-- Inner Motor Hub Visual -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.35}" length="${wheel_width + 0.01}"/>
        </geometry>
        <material name="matte_black"/>
      </visual>
      <!-- Wheel Collision Cylinder -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" ixy="0" ixz="0"
                 iyy="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" iyz="0"
                 izz="${0.5 * wheel_mass * wheel_radius * wheel_radius}"/>
      </inertial>
    </link>

    <!-- Continuous Drive Joint (Mounted at the bottom of the suspended leg) -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_leg_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_sign * 0.20} ${y_sign * 0.20} -0.23" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="80.0" velocity="12.0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <!-- Gazebo Wheel Surface Friction Properties -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>0.95</mu1>
      <mu2>0.75</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.002</minDepth>
      <material>
        <ambient>0.90 0.88 0.85 1.0</ambient>
        <diffuse>0.92 0.90 0.88 1.0</diffuse>
        <specular>0.1 0.1 0.1 1.0</specular>
      </material>
    </gazebo>

  </xacro:macro>

  <!-- Instantiate Four Legs & Wheels -->
  <!-- Left Side: y_sign = +1.0 -->
  <xacro:cat_leg_and_wheel prefix="front_left" x_sign="1.0"  y_sign="1.0"/>
  <xacro:cat_leg_and_wheel prefix="rear_left"  x_sign="-1.0" y_sign="1.0"/>

  <!-- Right Side: y_sign = -1.0 -->
  <xacro:cat_leg_and_wheel prefix="front_right" x_sign="1.0"  y_sign="-1.0"/>
  <xacro:cat_leg_and_wheel prefix="rear_right"  x_sign="-1.0" y_sign="-1.0"/>

  <!-- ================= IMU SENSOR ================= -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= SENSOR MAST & ZED 2i CAMERA ================= -->
  <link name="camera_mast_link">
    <visual>
      <origin xyz="0 0 ${mast_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${mast_radius}" length="${mast_height}"/>
      </geometry>
      <material name="aluminum_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${mast_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${mast_radius}" length="${mast_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${mast_height / 2.0}" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="camera_mast_joint" type="fixed">
    <parent link="top_deck_link"/>
    <child link="camera_mast_link"/>
    <!-- Mounted near front-center of top deck -->
    <origin xyz="${chassis_length/2.0 - 0.08} 0 0.006" rpy="0 0 0"/>
  </joint>

  <!-- ZED 2i Stereo Camera Bar (175mm wide, 30mm high, 33mm deep) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.033 0.175 0.030"/>
      </geometry>
      <material name="zed_dark"/>
    </visual>
    <!-- Left Lens Visual -->
    <visual>
      <origin xyz="0.017 0.06 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.004"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Right Lens Visual -->
    <visual>
      <origin xyz="0.017 -0.06 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.004"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.033 0.175 0.030"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="camera_mast_link"/>
    <child link="camera_link"/>
    <!-- Tilted downward ~20 degrees (camera_pitch) to inspect terrain 0.5m-3.5m ahead -->
    <origin xyz="0.02 0 ${mast_height}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- ROS Standard Optical Frame (Z Forward, X Right, Y Down) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ================= GAZEBO SENSORS & SYSTEM PLUGINS ================= -->

  <!-- IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor name="cat_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <topic>/imu/data</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ZED 2i Stereo RGB-D Depth Camera -->
  <gazebo reference="camera_link">
    <sensor name="zed2i_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15.0</update_rate>
      <topic>/depth_camera/image_raw</topic>
      <ignition_frame_id>camera_link</ignition_frame_id>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <!-- Horizontal FOV: ~110 deg matching ZED 2i wide-angle stereo -->
        <horizontal_fov>1.92</horizontal_fov>
        <image>
          <width>960</width>
          <height>540</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>8.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.35</near>
            <far>6.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- ================= ROS 2 CONTROL HARDWARE INTERFACES ================= -->
  <ros2_control name="IgnitionSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <!-- Passive Prismatic Suspension Joints (State Only) -->
    <joint name="front_left_leg_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_leg_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_leg_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_leg_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ================= GAZEBO ROS 2 CONTROL PLUGIN ================= -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find caterpillar_challenge)/config/ros2_controllers.yaml</parameters>
      <ros>
        <remapping>/diff_drive_base_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
        <remapping>/diff_drive_base_controller/odom:=/odom</remapping>
      </ros>
    </plugin>
  </gazebo>

</robot>
