        <!-- THE NEW 3D STL MAP -->
        <model name="map2_terrain">
            <static>true</static>
            <pose>0 0 0 0 0 0</pose>
            <link name="map_link">
                <collision name="map_collision">
                    <geometry>
                        <mesh>
                            <!-- Resolved relative to this installed world file. -->
                            <uri>map2.stl</uri>
                            <!-- SCALED UP 2x -->
                            <scale>2 2 2</scale>
                        </mesh>
                    </geometry>
                    <surface>
                        <friction>
                            <ode><mu>100.0</mu><mu2>50.0</mu2></ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="map_visual">
                    <geometry>
                        <mesh>
                            <uri>map2.stl</uri>
                            <!-- SCALED UP 2x -->
                            <scale>2 2 2</scale>
                        </mesh>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>
