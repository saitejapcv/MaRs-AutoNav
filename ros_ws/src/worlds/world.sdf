<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="my_world">
        <!-- 1. GPS Coordinates -->
        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <latitude_deg>12.8378</latitude_deg>
            <longitude_deg>80.1371</longitude_deg>
            <elevation>35.0</elevation>
            <heading_deg>0</heading_deg>
        </spherical_coordinates>

        <!-- 2. Core Gazebo Plugins -->
        <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
        <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
        <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
        <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>
        <plugin filename="libignition-gazebo-navsat-system.so" name="ignition::gazebo::systems::NavSat"/>

        <!-- 3. Physics Settings -->
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <!-- 4. Environment Lighting -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- 5. RAW STL TERRAIN -->
        <model name="terrain_1">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <mesh>
                            <uri>map2.stl</uri>
                            <scale>2.0 2.0 2.0</scale>
                        </mesh>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <mesh>
                            <uri>map2.stl</uri>
                            <scale>2.0 2.0 2.0</scale>
                        </mesh>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1.0</ambient>
                        <diffuse>0.7 0.7 0.7 1.0</diffuse>
                    </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>