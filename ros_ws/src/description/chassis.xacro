<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 ${wheel_zoffset + 0.23}" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.2"/>
    </inertial>
  </link>

  <link name="top_deck_link">
    <visual>
      <geometry><box size="${base_length * 0.95} ${base_width * 0.95} 0.01"/></geometry>
      <material name="gold"/>
    </visual>
  </link>
  <joint name="top_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_deck_link"/>
    <origin xyz="0.0 0.0 ${base_height / 2 + 0.005}" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>
  
  <!-- ================= ZED 2i CAMERA (FLOATING) ================= -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.14 0.04"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.14 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.16"/> 
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/> 
    <child link="camera_link"/>
    <!-- Floating exactly where the extension beam used to end -->
    <origin xyz="${camera_beam_x_start + camera_beam_length} ${camera_beam_y_offset} ${camera_beam_z_offset}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- Optical frame to match ROS image standards -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ================= GPS MODULE (FLOATING) ================= -->
  <link name="gps_link">
    <visual>
      <geometry><box size="0.04 0.04 0.015"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <!-- Floating on the rear-left corner -->
    <origin xyz="${gps_x_offset} ${gps_y_offset} ${gps_z_offset}" rpy="0 0 0"/>
  </joint>
</robot>