<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="test_world">
        <!-- IIITDM Kancheepuram Campus -->
        <spherical_coordinates>
        <surface_model>EARTH_WGS84</surface_model>
        <latitude_deg>12.8378</latitude_deg>
        <longitude_deg>80.1371</longitude_deg>
        <elevation>35.0</elevation>
        <heading_deg>0</heading_deg>
        </spherical_coordinates>
            <!-- 1. THE CORE GAZEBO PLUGINS (These make the world actually render and work) -->
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        
        <!-- 2. THE SENSOR PLUGIN (This makes the LiDAR work) -->
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <!-- 3. ENVIRONMENT -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 4. YOUR CONES (With collisions intact) -->
        <model name="red_cone">
            <pose>3.0 1.0 0.0 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <mesh>
                            <uri>file:///home/taper/ros2_ws/src/task3-5/robotsim/worlds/base_cone.dae</uri>
                            <scale>10.0 10.0 10.0</scale>
                        </mesh>
                    </geometry>
                    <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
                </visual>
                <collision name="collision">
                    <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
                </collision>
            </link>
        </model>

        <model name="green_cone">
            <pose>5.5 0.6 0.0 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <mesh>
                            <uri>file:///home/taper/ros2_ws/src/task3-5/robotsim/worlds/base_cone.dae</uri>
                            <scale>10.0 10.0 10.0</scale>
                        </mesh>
                    </geometry>
                    <material><ambient>0.0 0.7 0.1 1</ambient><diffuse>0.0 0.7 0.1 1</diffuse></material>
                </visual>
                <collision name="collision">
                    <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
                </collision>
            </link>
        </model>

        <model name="blue_cone">
            <pose>7.0 -0.5 0.0 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <mesh>
                            <uri>file:///home/taper/ros2_ws/src/task3-5/robotsim/worlds/base_cone.dae</uri>
                            <scale>10.0 10.0 10.0</scale>
                        </mesh>
                    </geometry>
                    <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
                </visual>
                <collision name="collision">
                    <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
                </collision>
            </link>
        </model>

        <model name="yellow_cone">
            <pose>5.0 0.5 0.0 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <mesh>
                            <uri>file:///home/taper/ros2_ws/src/task3-5/robotsim/worlds/base_cone.dae</uri>
                            <scale>10.0 10.0 10.0</scale>
                        </mesh>
                    </geometry>
                    <material><ambient>1.0 0.8 0.0 1</ambient><diffuse>1.0 0.8 0.0 1</diffuse></material>
                </visual>
                <collision name="collision">
                    <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
                </collision>
            </link>
        </model>

        <model name="orange_cone">
            <pose>4.5 -1.5 0.0 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <mesh>
                            <uri>file:///home/taper/ros2_ws/src/task3-5/robotsim/worlds/base_cone.dae</uri>
                            <scale>10.0 10.0 10.0</scale>
                        </mesh>
                    </geometry>
                    <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
                </visual>
                <collision name="collision">
                    <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
                </collision>
            </link>
        </model>
    </world>
</sdf>