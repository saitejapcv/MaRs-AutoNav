<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_rover">
    
    <link name='chassis_suspension_rod'>
        <visual>
            <origin xyz='0 0 0' rpy='0 0 0'/>
            <geometry>
                <cylinder radius='${chassis_suspension_rod_radius}' height='${chassis_suspension_rod_length}'/>
            </geometry>
        </visual>
        <collision>
            <origin xyz='0 0 0' rpy='0 0 0'/>
            <geometry>
                <cylinder radius='${chassis_suspension_rod_radius}' height='${chassis_suspension_rod_length}'/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz='0 0 0' rpy='0 0 0'/>
            <mass value='1'/>
            <xacro:cylinder_inertia m='1' r='${chassis_suspension_rod_radius}' h='${chassis_suspension_rod_length}'/>
        </inertial>
    </link>

    <link name="chassis_suspension_rod_2">
        <visual>
            <origin xyz='0 0 0' rpy='0 0 0'/>
            <geometry>
                <cylinder radius='${chassis_suspension_rod_radius}' height='${chassis_suspension_rod_length}'/>
            </geometry>
        </visual>
        <collision>
            <origin xyz='0 0 0' rpy='0 0 0'/>
            <geometry>
                <cylinder radius='${chassis_suspension_rod_radius}' height='${chassis_suspension_rod_length}'/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz='0 0 0' rpy='0 0 0'/>
            <mass value='1'/>
            <xacro:cylinder_inertia m='1' r='${chassis_suspension_rod_radius}' h='${chassis_suspension_rod_length}'/>
        </inertial>
    </link>

    <joint name='chassis_suspension_rod_joint' type='revolute'>
        <parent link='chassis'/>
        <child link='chassis_suspension_rod'/>
        <origin xyz='0 ${chassis_width/2+ chassis_suspension_rod_length} 0' rpy='${pi/2} 0 0'/>
        <axis xyz='0 0 1'/>
        <limit lower='-1.57' upper='1.57' effort='1000' velocity='1'/>
    </joint>
    
    <joint name='chassis_suspension_rod_2_joint' type='revolute'>
        <parent link='chassis'/>
        <child link='chassis_suspension_rod_2'/>
        <origin xyz='0 ${-chassis_width/2 - chassis_suspension_rod_length} 0' rpy='${pi/2} 0 0'/>
        <axis xyz='0 0 1'/>
        <limit lower='-1.57' upper='1.57' effort='1000' velocity='1'/>
    </joint>

</robot>